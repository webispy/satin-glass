{
  "name": "satin-glass-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm --filter docs dev",
    "test": "pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm build && pnpm --filter docs build && node tests/e2e/run.mjs",
    "e2e:quick": "pnpm build && pnpm --filter docs build && E2E_ENGINES=chromium node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "axe-core": "4.14.1",
    "playwright": "1.65.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
