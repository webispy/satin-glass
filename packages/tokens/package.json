{
  "name": "@satin-glass/tokens",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && tsx scripts/build-css.ts && tsx scripts/motion-doc.ts --check",
    "docs:motion": "tsx scripts/motion-doc.ts",
    "typecheck": "tsc --noEmit -p ."
  }
}
