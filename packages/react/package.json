{
  "name": "@satin-glass/react",
  "version": "0.4.0",
  "description": "React components on satin glass: frosted, grained translucency, a fixed top light and a soft sheen, with motion that stretches and sticks.",
  "keywords": ["react", "ui", "components", "design-system", "glass", "accessibility", "data-table", "charts", "satin-glass"],
  "homepage": "https://github.com/webispy/satin-glass#readme",
  "bugs": { "url": "https://github.com/webispy/satin-glass/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/webispy/satin-glass.git", "directory": "packages/react" },
  "author": "Inho Oh",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./foundation": {
      "types": "./dist/foundation.d.ts",
      "import": "./dist/foundation.js"
    },
    "./controls": {
      "types": "./dist/controls.d.ts",
      "import": "./dist/controls.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./selection": {
      "types": "./dist/selection.d.ts",
      "import": "./dist/selection.js"
    },
    "./overlays": {
      "types": "./dist/overlays.d.ts",
      "import": "./dist/overlays.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "import": "./dist/feedback.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css",
    "./css/*": "./dist/css/*"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "dependencies": {
    "@satin-glass/core": "workspace:*",
    "@satin-glass/tokens": "workspace:*"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vitest": "5.1.0",
    "jsdom": "31.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12"
  }
}
