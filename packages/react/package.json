{
  "name": "@glass-layer/react",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync(require.resolve('@glass-layer/core/styles.css'),'dist/styles.css')\"",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "peerDependencies": { "react": ">=18.2", "react-dom": ">=18.2" },
  "dependencies": { "@glass-layer/core": "workspace:*", "@glass-layer/tokens": "workspace:*" },
  "devDependencies": {
    "react": "19.3.1", "react-dom": "19.3.1", "@types/react": "19.3.0", "@types/react-dom": "19.3.0",
    "vitest": "5.1.0", "jsdom": "31.0.1", "@testing-library/react": "16.3.3", "@testing-library/user-event": "14.6.12"
  }
}
