{
  "name": "@satin-glass/core",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css",
    "./css/*": "./dist/css/*"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node scripts/bundle-css.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@satin-glass/tokens": "workspace:*"
  },
  "devDependencies": {
    "vitest": "5.1.0",
    "jsdom": "31.0.1"
  }
}
