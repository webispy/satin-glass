{
  "name": "@satin-glass/core",
  "version": "0.4.0",
  "description": "Framework-free behaviour and styles for Satin Glass: springs, the pointer sheen, the stretch-and-stick selection, overlay placement, focus and layer stacks, drag and long press.",
  "keywords": ["ui", "css", "spring", "animation", "design-system", "accessibility", "satin-glass"],
  "homepage": "https://webispy.github.io/satin-glass/",
  "bugs": { "url": "https://github.com/webispy/satin-glass/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/webispy/satin-glass.git", "directory": "packages/core" },
  "author": "Inho Oh",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css",
    "./css/*": "./dist/css/*"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node scripts/bundle-css.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@satin-glass/tokens": "workspace:*"
  },
  "devDependencies": {
    "vitest": "5.1.0",
    "jsdom": "31.0.1"
  }
}
